  RSA_N = BigInt.new("")
  
  # Public exponent (e)
  RSA_E = BigInt.new("65537")
  
  # Private exponent (d)
  RSA_D = BigInt.new("")
  
  # First prime factor (p)
  RSA_P = BigInt.new("")
  
  # Second prime factor (q)
  RSA_Q = BigInt.new("")
  
  # d mod (p-1) - used for CRT optimization
  RSA_DP = BigInt.new("")
  
  # d mod (q-1) - used for CRT optimization
  RSA_DQ = BigInt.new("")
  
  # Modular inverse of q modulo p - used for CRT optimization
  RSA_QINV = BigInt.new("")
  
