  # Helper methods for creating RSA instances
  
  # Creates an RSA instance with only public key components (n, e)
  # Useful for testing encryption and signature verification
  def self.create_public_key_rsa
    # This would create an RSA instance with just public components
    # Implementation depends on the RSA class structure
    {
      n: RSA_N,
      e: RSA_E
    }
  end
  
  # Creates a complete RSA private key instance with all components
  # Useful for testing decryption, signing, and key operations
  def self.create_private_key_rsa
    # This would create an RSA instance with all private key components
    # Implementation depends on the RSA class structure
    {
      n: RSA_N,
      e: RSA_E,
      d: RSA_D,
      p: RSA_P,
      q: RSA_Q,
      dp: RSA_DP,
      dq: RSA_DQ,
      qinv: RSA_QINV
    }
  end
  
  # Creates RSA instance from PEM data (for DER/PEM parsing tests)
  def self.create_rsa_from_pem
    RSA_PUBLIC_KEY_PEM
  end
  
