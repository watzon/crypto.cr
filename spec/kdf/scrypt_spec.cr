require "../spec_helper"

describe Crypto::KDF::SCrypt do
  it "Hashes a password correctly using static method" do
    password = "password"
    salt = "NaCl"
    hashed = Crypto::KDF::SCrypt.hash(password, salt, n: 10, r: 8, p: 16)
    hashed.to_a.should eq [
      0x0c, 0xce, 0x36, 0x7d, 0x4d, 0x81, 0x8e, 0x0e,
      0x97, 0x19, 0xd8, 0x2d, 0x7c, 0x48, 0xc9, 0x40,
      0x31, 0x32, 0xd7, 0x8d, 0x36, 0xda, 0xca, 0xf8,
      0x4d, 0x5f, 0x94, 0xbc, 0x35, 0x52, 0x22, 0x02,
      0xc6, 0xd3, 0x84, 0x57, 0x42, 0x28, 0x88, 0x65,
      0xd4, 0x3b, 0x86, 0x0f, 0x0e, 0xc1, 0x80, 0xa9,
      0x65, 0x78, 0xb5, 0xb8, 0xc3, 0x10, 0x95, 0x90,
      0x7e, 0xed, 0x5c, 0x56, 0xec, 0x00, 0x46, 0x43,
    ]
  end
  
  it "Derives a key using the KDF interface" do
    scrypt = Crypto::KDF::SCrypt.new(n: 10, r: 8, p: 16)
    password = "password"
    salt = "NaCl".to_slice
    
    derived = scrypt.derive(password, salt, 64)
    derived.to_a.should eq [
      0x0c, 0xce, 0x36, 0x7d, 0x4d, 0x81, 0x8e, 0x0e,
      0x97, 0x19, 0xd8, 0x2d, 0x7c, 0x48, 0xc9, 0x40,
      0x31, 0x32, 0xd7, 0x8d, 0x36, 0xda, 0xca, 0xf8,
      0x4d, 0x5f, 0x94, 0xbc, 0x35, 0x52, 0x22, 0x02,
      0xc6, 0xd3, 0x84, 0x57, 0x42, 0x28, 0x88, 0x65,
      0xd4, 0x3b, 0x86, 0x0f, 0x0e, 0xc1, 0x80, 0xa9,
      0x65, 0x78, 0xb5, 0xb8, 0xc3, 0x10, 0x95, 0x90,
      0x7e, 0xed, 0x5c, 0x56, 0xec, 0x00, 0x46, 0x43,
    ]
  end
  
  it "returns correct iteration count" do
    scrypt = Crypto::KDF::SCrypt.new(n: 10)
    scrypt.iterations.should eq(1024) # 2^10
  end
end
